# Data & caching
RAG_DATA_PATH=./data/cat-facts.txt
RAG_CACHE_DIR=./.cache

# Ollama models
RAG_EMBEDDING_MODEL=hf.co/CompendiumLabs/bge-base-en-v1.5-gguf
RAG_LANGUAGE_MODEL=hf.co/bartowski/Llama-3.2-1B-Instruct-GGUF

# Retrieval
RAG_TOP_N=3

# Chunking
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=20

# Logging
RAG_LOG_LEVEL=INFO